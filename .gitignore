# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's system of choice, but for an application, they might be check-in.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different OS, it may cause issues.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is of utility, but can be ignored if preferred.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is of utility, but can be ignored if preferred.
